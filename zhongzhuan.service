[Unit]
Description=Zhongzhuan API Relay
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/zhongzhuan
# src-layout：必须注入 PYTHONPATH，否则 -m zhongzhuan 找不到包
Environment=PYTHONPATH=/root/zhongzhuan/src
ExecStart=/usr/bin/python3 -m zhongzhuan
Restart=always
RestartSec=5
EnvironmentFile=/root/zhongzhuan/.env
# 2026-08-20：stdout/stderr 改走 journald（自动轮转、永不因文件被 rename 而假死）。
# 请求审计/统计在 TiDB request_logs，应用诊断日志在 journald + loguru 文件双份。
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
